# Postgres on Neon: the pooled connection string, with ?sslmode=require
# Use the dev branch locally and the main branch on Vercel.
DATABASE_URL=

# JWT secrets. Generate each with: openssl rand -base64 64
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Token lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Redis (Upstash REST) for rate limiting. From the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# One free Upstash database is shared by dev and prod, so keys get a prefix: dev: locally, prod: on Vercel
REDIS_KEY_PREFIX=dev:

# OAuth apps. Callback URLs: <APP_URL>/api/auth/oauth/google/callback and <APP_URL>/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public base URL of the app
APP_URL=http://localhost:3000
